# ──────────────────────────────────────────────────────────────
# Alexa+ Ambient Focus Agent — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# MOCK_MODE=true (default) requires NO third-party API keys.
# Set MOCK_MODE=false for real hardware integration.

# ── Mode ──────────────────────────────────────────────────────
MOCK_MODE=true                                # true = no network calls to third parties

# ── MCP Server ────────────────────────────────────────────────
MCP_HOST=127.0.0.1                            # bind address
MCP_PORT=8000                                 # listen port
MCP_PATH=/mcp                                 # MCP Streamable HTTP endpoint path
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCP_AUTH_TOKEN=change-me                      # Bearer token required on /mcp

# ── IFTTT Webhooks (smart lights) ─────────────────────────────
IFTTT_WEBHOOK_KEY=                            # your Maker Webhooks key
IFTTT_EVENT_FOCUS=focus_mode                  # event name for focus scene
IFTTT_EVENT_BREAK=break_mode                  # event name for break scene
IFTTT_EVENT_RESTORE=restore_lights            # event name for restoring lights

# ── Phone DND ─────────────────────────────────────────────────
PHONE_PLATFORM=android                        # android | ios

# Android (MacroDroid)
MACRODROID_WEBHOOK_URL_DND_ON=                # MacroDroid webhook to enable DND
MACRODROID_WEBHOOK_URL_DND_OFF=               # MacroDroid webhook to disable DND

# iOS (Pushcut)
PUSHCUT_API_KEY=                              # Pushcut API key
PUSHCUT_NOTIFICATION_DND_ON=                  # Pushcut notification name for DND on
PUSHCUT_NOTIFICATION_DND_OFF=                 # Pushcut notification name for DND off

# ── Media ─────────────────────────────────────────────────────
FOCUS_MEDIA_URL=                              # lo-fi stream / SoundCloud URL for web UI

# ── Session defaults ──────────────────────────────────────────
DEFAULT_FOCUS_MINUTES=25
DEFAULT_BREAK_MINUTES=5
CONFIRMATION_TTL_SECONDS=60
ADAPTER_TIMEOUT_SECONDS=5
